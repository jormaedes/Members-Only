<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>Login</title>
		<link rel="stylesheet" href="/css/output.css">
		<link href="https://cdn.jsdelivr.net/npm/remixicon@2.5.0/fonts/remixicon.css" rel="stylesheet">
	</head>
	<body class="auth-body">
		<% let usernameError = undefined, passwordError = undefined; %>
		<% if (messages && messages.length > 0) {
			usernameError = messages.find(m => m.includes("username"));
			passwordError = messages.find(m => m.includes("password"));
		} %>
		<main class="auth-page">
			<aside class="auth-aside">
				<a href="/" class="brand" aria-label="MemberOnly home">
					<span class="brand-mark">M</span>
					<span class="brand-name">MemberOnly</span>
				</a>
				<div class="auth-message">
					<p class="eyebrow">A private place to share</p>
					<h1>Good stories stay close.</h1>
					<p>Pick up where your circle left off.</p>
				</div>
				<p class="auth-aside-note">Small circle. Open conversation.</p>
			</aside>
			<section class="auth-form-panel" aria-labelledby="login-title">
				<div class="auth-form-inner">
					<a class="auth-back" href="/">&larr; Back to MemberOnly</a>
					<h2 id="login-title" class="mt-7">Welcome back</h2>
					<p class="auth-intro">Sign in to catch up with your members.</p>
					<form action="/login" method="post" class="auth-form">
						<div class="field">
							<label for="username">Username</label>
							<input class="input" type="text" id="username" name="username" autocomplete="username" required>
							<% if (usernameError) { %><p class="auth-error"><%= usernameError %></p><% } %>
						</div>
						<div class="field">
							<label for="password">Password</label>
							<input class="input" type="password" id="password" name="password" autocomplete="current-password" required>
							<% if (passwordError) { %><p class="auth-error"><%= passwordError %></p><% } %>
						</div>
						<button class="btn-primary auth-submit" type="submit">Log in <span aria-hidden="true">&rarr;</span></button>
					</form>
					<p class="auth-switch">New to the club? <a href="/sign-up">Create an account</a></p>
				</div>
			</section>
		</main>
	</body>
</html>