<header class="bg-white border-b">
	<link href="https://cdn.jsdelivr.net/npm/remixicon@2.5.0/fonts/remixicon.css" rel="stylesheet">
	<div class="container mx-auto flex items-center justify-between h-16">
		<div class="flex items-center gap-6">
			<a href="/" class="text-2xl font-extrabold text-gray-900">MemberOnly</a>
			<nav class="hidden md:flex items-center gap-6 text-sm text-gray-600">
				<a href="/become-member" class="hover:text-gray-900">Join the Club</a>
				<a href="/become-admin" class="hover:text-gray-900">Become admin</a>
			</nav>
		</div>

		<div class="flex items-center gap-4">
			<% if (!locals.user) { %>
				<a href="/login" class="text-sm px-3 py-1.5 border rounded-md">Login</a>
				<a href="/sign-up" class="btn-primary">Sign up</a>
			<% } else { %>
				<span class="text-sm text-gray-600 hidden sm:inline">Welcome, <%= locals.user.first_name %></span>
				<a href="/logout" class="px-3 py-1.5 border rounded-md text-sm">Logout</a>
			<% } %>
			<!-- mobile menu button -->
			<button id="menu-toggle" class="md:hidden ml-2 p-2 rounded-md border" aria-label="Open menu">
				<i class="ri-menu-line text-xl"></i>
			</button>
		</div>
	</div>

	<!-- mobile menu panel -->
	<div id="mobile-menu" class="md:hidden hidden border-t bg-white">
		<div class="container mx-auto py-3 flex flex-col gap-2">
			<a href="/become-member" class="px-3 py-2 rounded hover:bg-gray-50">Join the Club</a>
			<a href="/become-admin" class="px-3 py-2 rounded hover:bg-gray-50">Become admin</a>
			<% if (!locals.user) { %>
				<a href="/login" class="px-3 py-2 rounded hover:bg-gray-50">Login</a>
				<a href="/sign-up" class="px-3 py-2 rounded hover:bg-gray-50">Sign up</a>
			<% } else { %>
				<div class="px-3 py-2 text-sm text-gray-700">Signed in as <span class="font-medium"><%= locals.user.username %></span></div>
				<a href="/logout" class="px-3 py-2 rounded hover:bg-gray-50">Logout</a>
			<% } %>
		</div>
	</div>

	<script>
		(function(){
			const btn = document.getElementById('menu-toggle');
			const menu = document.getElementById('mobile-menu');
			if (!btn || !menu) return;
			btn.addEventListener('click', function(){
				menu.classList.toggle('hidden');
			});
		})();
	</script>
</header>