<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>Become an Admin</title>
		<link rel="stylesheet" href="/css/output.css">
		<link href="https://cdn.jsdelivr.net/npm/remixicon@2.5.0/fonts/remixicon.css" rel="stylesheet">
	</head>
	<body class="min-h-screen flex flex-col bg-gray-50 text-gray-900">
		<%- include('header', { user }) %>
		<main class="container mx-auto grid place-items-center py-16 flex-1">
			<div class="w-full max-w-md card text-center">
				<h2 class="text-2xl font-extrabold mb-2">Become an Admin</h2>
				<p class="text-sm text-gray-600 mb-6">What has teeth but cannot bite?</p>
				<form action="/become-admin" method="post" class="space-y-4">
					<input class="input" type="text" name="answer" id="answer" placeholder="Admin passcode">
					<% if(locals.errorMsg) { %>
						<p class="text-sm text-red-600"><%= locals.errorMsg %></p>
					<% } %>
					<div class="flex justify-center">
						<button class="btn-primary" type="submit">Become admin</button>
					</div>
				</form>
			</div>
		</main>
		<%- include('footer') %>
	</body>
</html>