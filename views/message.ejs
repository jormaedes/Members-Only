<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>Create a new message</title>
		<link rel="stylesheet" href="/css/output.css">
		<link href="https://cdn.jsdelivr.net/npm/remixicon@2.5.0/fonts/remixicon.css" rel="stylesheet">
	</head>
	<body class="min-h-screen flex flex-col bg-gray-50 text-gray-900">
		<%- include('header', { user: locals.user }) %>
		<main class="site-container page-main">
			<a href="/" class="auth-back">&larr; Back to the club</a>
			<div class="w-full max-w-2xl card mx-auto">
				<h1 class="text-2xl font-extrabold mb-2">Create a new message</h1>
				<p class="text-sm text-gray-500 mb-6">Share something with the club.</p>
				<form action="/new-message" method="post" class="space-y-5">
					<div class="field">
						<label for="title">Title</label>
						<input class="input" type="text" name="title" id="title" placeholder="Give your message a clear title" required>
					</div>
					<div class="field">
						<label for="message">Content</label>
						<textarea class="input h-40" name="message" id="message" placeholder="Write your message here..." required></textarea>
					</div>
					<div class="flex justify-end gap-4">
						<a href="/" class="btn-secondary">Cancel</a>
						<button class="btn-primary" type="submit">Publish message <span aria-hidden="true">&rarr;</span></button>
					</div>
				</form>
			</div>
		</main>
		<%- include('footer') %>
	</body>
</html>