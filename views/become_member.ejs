<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>Join the Club</title>
		<link rel="stylesheet" href="/css/output.css">
		<link href="https://cdn.jsdelivr.net/npm/remixicon@2.5.0/fonts/remixicon.css" rel="stylesheet">
	</head>
	<body class="min-h-screen flex flex-col bg-gray-50 text-gray-900">
		<%- include('header', { user }) %>
		<main class="site-container page-main grid place-items-center">
			<div class="w-full max-w-md card text-center">
				<p class="eyebrow">A note from the members</p>
				<h1 class="text-2xl font-extrabold mb-2">Join the club</h1>
				<p class="text-sm text-gray-600 mb-6">What goes around and around but never moves?</p>
				<form action="/become-member" method="post" class="auth-form">
					<div class="field">
						<label for="answer">Your answer</label>
						<input class="input" type="text" name="answer" id="answer" placeholder="Enter the answer">
					</div>
					<div class="flex justify-center">
						<button class="btn-primary" type="submit">Join the club <span aria-hidden="true">&rarr;</span></button>
					</div>
				</form>
			</div>
		</main>
		<%- include('footer') %>
	</body>
</html>