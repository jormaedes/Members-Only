<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Members Only</title>
</head>
<body>
	<%- include('header', { user: locals.user }) %>
	<% if (!locals.user) {%>
		<h2>Welcome to Members Only</h2>
		<%- include('showmessages', { messages: locals.messages, user: undefined }) %>
	<% } else { %>
		<h2>Welcome, <%= locals.user.username %>!</h2>
		<%- include('showmessages', { messages: locals.messages, user: locals.user }) %>
		<p><a href="/new-message">Add message</a></p>
	<% } %>
	<%- include('footer') %>
</body>
</html>