<!-- msg.ejs -->
<article class="card mb-6">
	<% if (locals.user && locals.user.is_member) { %>
		<div class="flex items-start gap-4">
			<div class="avatar-sm"> <%= (message.first_name || 'U').slice(0,1) %><%= (message.last_name || '').slice(0,1) %> </div>
			<div class="flex-1">
				<div class="flex items-center justify-between">
					<div>
						<p class="text-sm font-semibold"><%= message.first_name %> <%= message.last_name %></p>
						<p class="text-xs text-gray-500"><%= new Date(message.created_at).toLocaleString() %></p>
					</div>
					<% if (locals.user && locals.user.is_admin) { %>
						<a href="/messages/<%= message.id %>/delete" class="text-gray-400 hover:text-red-600"><i class="ri-close-circle-fill"></i></a>
					<% } %>
				</div>

				<h3 class="mt-4 text-lg font-semibold"><%= message.title %></h3>
				<p class="mt-2 text-gray-700"><%= message.text %></p>
			</div>
		</div>
	<% } else { %>
		<div>
			<div class="flex-1">
				<div class="flex items-center justify-between">
					<div>
						<p class="text-sm font-semibold">***** ****** </p>
						<p class="text-xs text-gray-500">*********</p>
					</div>
				</div>
			</div>
			<h3 class="text-lg font-semibold"><%= message.title %></h3>
			<p class="mt-2 text-gray-700"><%= message.text %></p>
		</div>
	<% } %>
</article>