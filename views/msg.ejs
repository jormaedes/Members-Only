<article class="card message-card">
	<% if (locals.user && locals.user.is_member) { %>
		<div class="message-head">
			<div class="avatar-sm"><%= (message.first_name || 'U').slice(0, 1) %><%= (message.last_name || '').slice(0, 1) %></div>
			<div>
				<p class="message-author"><%= message.first_name %> <%= message.last_name %></p>
				<p class="message-date"><%= new Date(message.created_at).toLocaleString() %></p>
			</div>
			<% if (locals.user && locals.user.is_admin) { %>
				<a href="/messages/<%= message.id %>/delete" class="message-delete" aria-label="Delete message" title="Delete message"><i class="ri-close-circle-fill" aria-hidden="true"></i></a>
			<% } %>
		</div>
		<h2 class="message-title"><%= message.title %></h2>
		<p class="message-text"><%= message.text %></p>
	<% } else { %>
		<p class="message-author">***** ******</p>
		<p class="message-date">*********</p>
		<h2 class="message-title"><%= message.title %></h2>
		<p class="message-text"><%= message.text %></p>
	<% } %>
</article>