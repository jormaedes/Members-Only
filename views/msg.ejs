<!-- msg.ejs -->
<article class="message">
	<% if (!locals.user || !locals.user.is_member) { %>
		<div>
			<p class="meta"> ************** </p>
			<p> ************* </p>
		</div>
	<% } %>
	<% if (locals.user && locals.user.is_member) { %>
		<div>
			<p class="meta"><%= message.first_name %> <%= message.last_name %> </p>
			<p> <%= new Date(message.created_at).toLocaleDateString() %></p>
		</div>
	<% } %>

	<% if (locals.user && locals.user.is_admin) { %>
		<a href="/messages/<%= message.id %>/delete">Delete</a>
	<% } %>
	<div>
		<h3><%= message.title %></h3>
		<p><%= message.text %></p>
	</div>
</article>