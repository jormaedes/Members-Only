<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/output.css">
  <title>Error</title>
</head>
<body class="min-h-screen flex flex-col bg-gray-50">
  <%- include('header') %>

  <main class="site-container page-main grid place-items-center">
      <div class="max-w-2xl w-full card">
        <p class="eyebrow">Something went wrong</p>
        <h1 class="text-2xl font-semibold text-gray-900">An error occurred</h1>
        <% if (typeof status !== 'undefined') { %>
          <p class="mt-2 text-sm text-gray-600">Status: <%= status %></p>
        <% } %>
        <% if (message) { %>
          <p class="mt-4 text-gray-700"><%= message %></p>
        <% } %>
        <% if (locals.errors) { %>
          <%- include('error_types', { errors: errors }) %>
        <% } %>
        <div class="mt-6 flex gap-2">
          <a href="/" class="btn-primary">Home</a>
          <a href="javascript:history.back()" class="btn-secondary">Go back</a>
        </div>
      </div>
  </main>

  <%- include('footer') %>
</body>
</html>
